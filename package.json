{
  "name": "regionala-utvecklingsdatabasen-mcp",
  "version": "0.5.0",
  "description": "Publik metadata-MCP för Regionala utvecklingsdatabasen, utan MONA-anslutning",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc",
    "dev": "wrangler dev --ip 127.0.0.1",
