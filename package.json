    "deploy": "wrangler deploy",
    "smoke": "node --import tsx scripts/smoke-client.ts"
  },
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  },
  "private": true
}
